# ── Variables de producción para Hostinger (Websites → tu Web App → Environment variables) ──
# Puedes usar "Import from .env file" con este archivo ya completado. NO lo subas a GitHub.

# Base de datos MySQL (hPanel → Bases de datos → Gestión). El host suele ser "localhost".
# Si la contraseña tiene caracteres especiales (@ : / # ?), escríbelos codificados (@ → %40).
DATABASE_URL=mysql://u123456789_concilia:CONTRASEÑA@localhost:3306/u123456789_concilia

# Genera cada secreto con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://concilia.arkandevstudio.com
INGEST_SECRET=

# ── Buzón donde los negocios reenvían los avisos (correo de Hostinger) ──
NEXT_PUBLIC_INBOUND_MODE=mailbox
NEXT_PUBLIC_INBOUND_ADDRESS=pagos@arkandevstudio.com
# Datos IMAP: hPanel → Correos → pagos@… → Configuración / Clientes de correo (verifícalos ahí)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=pagos@arkandevstudio.com
IMAP_PASSWORD=

NODE_ENV=production
