# Copia este archivo a .env
# Local (MySQL/MariaDB de tu PC o Docker):
DATABASE_URL=mysql://concilia:concilia@127.0.0.1:3306/concilia

# Genera uno con: npx @better-auth/cli secret   (o cualquier cadena larga aleatoria)
BETTER_AUTH_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
BETTER_AUTH_URL=http://localhost:3000

# Clave que comparte el Email Worker de Cloudflare para enviar transferencias a /api/ingest
INGEST_SECRET=cambia-esto-tambien

# Dominio de los correos de reenvío (se muestra en el panel)
NEXT_PUBLIC_INBOUND_DOMAIN=in.arkandevstudio.com
NEXT_PUBLIC_INBOUND_PREFIX=pagos

# Solo desarrollo: URL de la app y alias por defecto para `npm run email:send`
APP_URL=http://localhost:3000
# DEV_ALIAS=pega-aqui-el-alias-que-ves-en-el-panel

# Recepción: "mailbox" = un buzón para todos (identifica al negocio por el correo registrado en Bancos)
NEXT_PUBLIC_INBOUND_MODE=mailbox
NEXT_PUBLIC_INBOUND_ADDRESS=pagos@arkandevstudio.com
# Para escuchar un buzón real en local (opcional). Si no los defines, usa npm run email:send
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_USER=pagos@arkandevstudio.com
# IMAP_PASSWORD=
